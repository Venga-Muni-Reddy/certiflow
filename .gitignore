# Dependencies
node_modules/
.pnp
.pnp.js

# Production and test build artifacts
dist/
build/
*.tsbuildinfo
coverage/
backend/prisma/*.js
backend/prisma/*.js.map
backend/prisma/*.d.ts
backend/prisma/*.d.ts.map

# Environment files (exclude secrets, keep templates)
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# OS and IDE files
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated Certificate PDFs & Local Storage
certificates_storage/
/tmp/

# Ignore runtime generated PDFs, but keep documentation PDFs
*.pdf
!docs/*.pdf
!docs/**/*.pdf
