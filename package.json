{
  "name": "certiflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CertiFlow - Pragati Skills Mission Certificate Issuance & Verification Platform",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "whatsapp-mock"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=shared",
    "build": "npm run build:shared && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:whatsapp": "npm run dev --workspace=whatsapp-mock"
  },
  "keywords": [
    "certiflow",
    "auditability",
    "certificates",
    "event-driven"
  ],
  "author": "Pragati Skills Mission Team",
  "license": "UNLICENSED"
}
