# ==============================================================================
# CertiFlow Platform - Root Environment Configuration (.env.example)
# Pragati Skills Mission Certificate Issuance & Verification Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API & Worker Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:5173

# Database (PostgreSQL 16)
# Local bare-metal: localhost:5432 | Docker Compose: postgres:5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/certiflow?schema=public"

# Cache & Message Broker (Redis 7)
# Local bare-metal: localhost:6379 | Docker Compose: redis:6379
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="certiflow-demo-secret-key-super-secure-change-in-production-2026"
JWT_EXPIRES_IN="7d"
DEMO_MODE=true

# SLA Monitoring (Moment #5)
# In demo mode, stale threshold is 30 seconds for quick testing; in production: 86400 (24h)
SLA_THRESHOLD_SECONDS=30
SLA_CHECK_INTERVAL_SECONDS=15

# WhatsApp Stand-In Mock Service
# Local bare-metal: localhost:4001 | Docker Compose: whatsapp-mock:4001
WHATSAPP_SERVICE_URL="http://localhost:4001"

# Certificate Storage (Local disk fallback vs MinIO / S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./certificates_storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=certiflow-certs
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# WhatsApp Mock Service Configuration
# ------------------------------------------------------------------------------
WHATSAPP_MOCK_PORT=4001
WHATSAPP_FAILURE_RATE=0.3
WHATSAPP_TIMEOUT_RATE=0.1

# ------------------------------------------------------------------------------
# Frontend Application Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:4000/api/v1
VITE_WHATSAPP_INBOX_URL=http://localhost:4001/inbox
