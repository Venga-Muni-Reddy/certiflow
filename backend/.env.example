# Backend & BullMQ Worker Environment
PORT=4000
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:5173

# Database & Cache
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/certiflow?schema=public"
REDIS_URL="redis://localhost:6379"

# Security
JWT_SECRET="certiflow-demo-secret-key-super-secure-change-in-production-2026"
JWT_EXPIRES_IN="7d"
DEMO_MODE=true

# SLA Configuration (30s for demo, 86400s for prod)
SLA_THRESHOLD_SECONDS=30
SLA_CHECK_INTERVAL_SECONDS=15

# WhatsApp Stand-In Service
WHATSAPP_SERVICE_URL="http://localhost:4001"

# Object Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./certificates_storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=certiflow-certs
S3_REGION=us-east-1
